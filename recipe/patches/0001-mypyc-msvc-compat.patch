Skip mypyc for models/__init__.py and split C output on Windows

MSVC caps string literals at 16,380 chars, which mypyc's encoded
source map exceeds in single-file mode, so build with separate=true.
In separate mode hatch-mypyc 0.16.0 does not package the group library
mypyc emits for a package __init__, so models/__init__.py stays pure
Python. Upstream's own Windows wheels apply these same two changes;
see .github/workflows/release.yml in the chardet repository.

diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -82,7 +82,6 @@
 dependencies = ["hatch-mypyc>=0.16.0", "mypy>=1.19"]
 require-runtime-dependencies = false
 include = [
-    "/src/chardet/models/__init__.py",
     "/src/chardet/models/_format.py",
     "/src/chardet/pipeline/structural.py",
     "/src/chardet/pipeline/validity.py",
@@ -99,7 +98,7 @@
     "/src/chardet/pipeline/postprocess.py",
 ]
 mypy-args = ["--ignore-missing-imports"]
-options = { debug_level = "0" }
+options = { debug_level = "0", separate = true }
 
 [tool.pytest]
 testpaths = ["tests", "scripts/tests"]
